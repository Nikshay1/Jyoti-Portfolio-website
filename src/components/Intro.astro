---
import { intro } from "../content/site";
import backdrop from "../assets/intro-blur.jpg";
import avatar from "../assets/jyoti-avatar.jpg";

const chars = (s: string) => [...s];
const { question } = intro;
---

<div class="intro" aria-hidden="true">
  <svg class="op-defs" width="0" height="0">
    <filter id="op-whip" x="-10%" y="-10%" width="120%" height="120%">
      <feGaussianBlur stdDeviation="0 0"></feGaussianBlur>
    </filter>
  </svg>

  <div class="op op-pill">
    <div class="pl">
      <span class="pl-btn pl-in">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </span>
      <span class="pl-bar pl-in">
        <svg class="pl-tabs" viewBox="0 0 16 16" aria-hidden="true"><rect x="2.5" y="3" width="11" height="6.5" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.3"></rect><path d="M4 12.5h8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path></svg>
        <span class="pl-ph">{chars(intro.placeholder).map((c) => <span>{c}</span>)}</span>
        <span class="pl-input">{chars(intro.typed).map((c) => <span class="pl-ch">{c}</span>)}<i class="pl-caret"></i></span>
        <svg class="pl-reload" viewBox="0 0 16 16" aria-hidden="true"><path d="M13 8a5 5 0 1 1-1.6-3.7M13 2v3h-3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </span>
      <span class="pl-btn pl-in">
        <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="3.5" cy="8" r="1.3" fill="currentColor"></circle><circle cx="8" cy="8" r="1.3" fill="currentColor"></circle><circle cx="12.5" cy="8" r="1.3" fill="currentColor"></circle></svg>
      </span>
      <i class="pl-mark"><i></i></i>
    </div>
  </div>

  <div class="op op-band">
    <div class="b-clip">
      <img class="b-img" src={backdrop.src} width={backdrop.width} height={backdrop.height} alt="" decoding="async" />
      <i class="b-veil"></i>
      <div class="b-strip">
        <i class="b-glass"></i>
        <p class="b-line">
          {intro.tagline.split(" ").map((word) => (
            <span class="b-word">{chars(word).map((c) => <span class="b-ch">{c}</span>)}</span>
          ))}<i class="b-caret"></i>
        </p>
      </div>
      <p class="b-ask">{intro.ask}</p>
    </div>
  </div>

  <div class="op op-q">
    <div class="q-cam">
        <span class="q-lead">{chars(question.before).map((c) => <span class="q-ch">{c}</span>)}</span>
        <span class="q-slot is-plain">
          {question.formats.map((f, i) => (
            <span class="q-item" data-tone={f.tone}>
              <span class="q-tile">{f.tile}</span>
              <span class="q-word">
                {i === 0 ? chars(f.label).map((c) => <span class="q-ch">{c}</span>) : f.label}
              </span>
            </span>
          ))}
        </span>
        <span class="q-end">
          <span class="q-tail">{chars(question.after).map((c) => <span class="q-ch">{c}</span>)}</span>
          <span class="q-find"><span class="q-find-in"><i class="q-spin"></i><span class="q-find-t">{intro.searching}</span></span></span>
        </span>
    </div>
  </div>

  <div class="op op-cards">
    {intro.proof.map((p) => (
      <figure class="pc" data-tone={p.tone}>
        <figcaption class="pc-tag">
          <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1h4l2.5 2.5V11H3z" fill="currentColor"></path></svg>
          {p.tag}
        </figcaption>
        <div class="pc-poster">
          <div class={`pc-motif pc-${p.motif}`}>
            {p.motif === "serp" && <><i></i><i></i><i></i></>}
            {p.motif === "spark" && <svg viewBox="0 0 100 100"><path d="M50 0c3 31 19 47 50 50-31 3-47 19-50 50-3-31-19-47-50-50 31-3 47-19 50-50Z" fill="currentColor"></path></svg>}
            {p.motif === "arrow" && <svg viewBox="0 0 100 100"><path d="M50 4v90M14 58l36 36 36-36" fill="none" stroke="currentColor" stroke-width="14"></path></svg>}
          </div>
          <p class:list={["pc-fig", { "pc-fig-long": p.figure.length > 3 }]}>{p.figure}</p>
          <p class="pc-line">{p.line}</p>
        </div>
      </figure>
    ))}
  </div>

  <div class="op op-end">
    <i class="e-fall"></i>
    <p class="e-line">
      <span class="e-word">{intro.closer}</span>
      <span class="e-face"><i class="e-halo"></i><img src={avatar.src} width={avatar.width} height={avatar.height} alt="" decoding="async" /></span>
    </p>
  </div>

  <button class="intro-skip" type="button" tabindex="-1">Skip intro</button>
</div>
