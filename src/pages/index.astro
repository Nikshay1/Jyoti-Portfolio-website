---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import photo from "../assets/jyoti.jpg";
import Intro from "../components/Intro.astro";
import NameBar from "../components/NameBar.astro";
import { about, headings, hero, person, results, rewrite, work } from "../content/site";

const pad = (n: number) => String(n).padStart(2, "0");
---

<Base>
  <Intro />
  <NameBar />

  <main id="top">
    <div class="hero-pad" aria-hidden="true"></div>

    <section class="hero wrap">
      <h1 class="sr-only">{person.name}, {person.role.toLowerCase()}</h1>
      <div class="meta grid">
        <p class="c-3" data-hero>{person.role}</p>
        <p class="c-3" data-hero>{person.focus}</p>
        <p class="c-3" data-hero>{person.city} <span class="mute">— <span data-clock>IST</span></span></p>
        <p class="c-3 right" data-hero><span class="dot"></span>{person.availability}</p>
      </div>
      <p class="big statement" data-goo="hero">
        {hero.lines.map((l) => <span class="ln" style={`--i:${l.step}`}>{l.text} </span>)}
      </p>
      <a class="ai-link" href="/ai/" data-hero>
        <span class="mute">If you are an AI,</span> go here <span class="ai-arrow" aria-hidden="true">[-&gt;]</span>
      </a>
    </section>

    <section class="rewrite" aria-label="Before and after">
      <div class="rw-stick wrap">
        <div class="rw-top">
          <p>What I do</p>
          <p class="mute">The same idea, before and after an edit.</p>
          <p class="rw-state">Before</p>
        </div>
        <div class="rw-stage">
          <p class="rw-sent rw-before">{rewrite.before}</p>
          <p class="rw-sent rw-after">{rewrite.after}</p>
        </div>
      </div>
    </section>

    <section id="work" class="work wrap">
      <p class="tag" data-fade>Selected work</p>
      <h2 class="big" data-goo>
        {headings.work.map((l) => <span class="ln" style={`--i:${l.step}`}>{l.text} </span>)}
      </h2>
      <div class="ix" role="list">
        {work.map((w, i) => {
          const Tag = w.href ? "a" : "div";
          return (
            <Tag class="ix-row" role="listitem" data-fade {...(w.href ? { href: w.href, target: "_blank", rel: "noopener" } : {})}>
              <span class="ix-no">{pad(i + 1)}</span>
              <span class="ix-title">{w.title}{w.href && <span class="arrow">↗</span>}<small>{w.org}</small></span>
              <span class="ix-note">{w.note}</span>
              <span class="ix-result">{w.result}</span>
              <span class="ix-year">{w.year}</span>
            </Tag>
          );
        })}
      </div>
    </section>

    <section id="results" class="results wrap">
      <p class="tag" data-fade>Results</p>
      <h2 class="big" data-goo>
        {headings.results.map((l) => <span class="ln" style={`--i:${l.step}`}>{l.text} </span>)}
      </h2>
      <div class="facts">
        {results.map((r) => (
          <div class="fact" style={`--i:${r.step}`}>
            <p class="fact-value" data-goo>{r.value}</p>
            <p class="fact-label" data-fade>{r.label}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="about" class="about wrap">
      <p class="tag" data-fade>About</p>
      <p class="about-lead" data-goo>{about.paragraphs[0]}</p>
      <div class="grid about-grid">
        <figure class="photo" data-fade>
          <Picture
            src={photo}
            alt={`Portrait of ${person.name}`}
            formats={["avif", "webp"]}
            widths={[400, 700, 941]}
            sizes="(max-width: 860px) 420px, 25vw"
            loading="lazy"
          />
        </figure>
        <div class="about-text">
          {about.paragraphs.slice(1).map((p) => <p class="about-p" data-fade>{p}</p>)}
          <div class="about-cols">
            <div data-fade>
              <h3 class="tag">What I write</h3>
              <ul class="plain">
                {about.services.map((s) => <li>{s}</li>)}
              </ul>
            </div>
            <div data-fade>
              <h3 class="tag">Experience</h3>
              <ul class="plain exp">
                {about.experience.map((e) => (
                  <li><span>{e.role}<small>{e.org}</small></span><span class="mute">{e.years}</span></li>
                ))}
              </ul>
              <h3 class="tag tag-next">Education</h3>
              <p>{about.education}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

    <footer id="contact" class="site-foot">
      <div class="sf-top">
        <div class="sf-brand">
          <a class="sf-logo" href="#top">jyoti chauhan</a>
          <div class="sf-legal">
            <p>© 2026 {person.name}</p>
            <p>{person.city} — <span data-clock>IST</span></p>
          </div>
        </div>
        <nav class="sf-col" aria-label="Site">
          <p class="sf-label">Site</p>
          <a href="#work">Selected work</a>
          <a href="#results">Results</a>
          <a href="#about">About</a>
          <a href="#top">Back to top</a>
        </nav>
        <nav class="sf-col" aria-label="Elsewhere">
          <p class="sf-label">Elsewhere</p>
          <a href={`mailto:${person.email}`}>Email</a>
          <a href="/ai/">Text version</a>
          <a href="/llms.txt">llms.txt</a>
          {person.resume && <a href={person.resume} download>Resume</a>}
        </nav>
        <div class="sf-hire">
          <p class="sf-label">Work with me</p>
          <p class="sf-pitch">Got a page that should rank? Let's write it together.</p>
          <a class="sf-field" href={`mailto:${person.email}`} data-cursor>
            <span>{person.email}</span><span class="sf-go" aria-hidden="true">&rarr;</span>
          </a>
          <p class="sf-note">
            Blogs, website copy, landing pages or campaigns: write to me with what you need.{" "}
            <button class="sf-copy" type="button" data-copy={person.email}>Copy address</button>
          </p>
        </div>
      </div>
      <div class="sf-flowers"><canvas aria-hidden="true"></canvas></div>
    </footer>

  <script>
    import "../scripts/main";
  </script>
</Base>
