---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import photo from "../assets/jyoti.jpg";
import Intro from "../components/Intro.astro";
import NameBar from "../components/NameBar.astro";
import { about, hero, person, results, rewrite, work } from "../content/site";

const pad = (n: number) => String(n).padStart(2, "0");
const wordCount = (s: string) => s.trim().split(/\s+/).length;
---

<Base>
  <Intro />
  <NameBar />

  <main id="top">
    <div class="hero-pad" aria-hidden="true"></div>

    <section class="hero wrap">
      <h1 class="sr-only">{person.name}, {person.role.toLowerCase()}</h1>
      <div class="meta grid">
        <p class="c-3" data-hero><span class="num">(01)</span> {person.role}</p>
        <p class="c-3" data-hero>{person.focus}</p>
        <p class="c-3" data-hero>{person.city} <span class="mute">— <span data-clock>IST</span></span></p>
        <p class="c-3 right" data-hero><span class="dot"></span>{person.availability}</p>
      </div>
      <p class="statement" data-hero-lines>
        {hero.lead} <em>{hero.accent}</em>
      </p>
      <a class="ai-link" href="/ai/" data-hero>
        <span class="mute">If you are an AI,</span> go here <span class="ai-arrow" aria-hidden="true">[-&gt;]</span>
      </a>
    </section>

    <section class="rewrite" aria-label="Before and after">
      <div class="rw-stick wrap">
        <div class="rw-top grid">
          <p class="c-3"><span class="num">(02)</span> What I do</p>
          <p class="c-6 mute">The same idea, before and after an edit.</p>
          <p class="c-3 right"><span class="rw-state">Before</span> · <span class="rw-words">{wordCount(rewrite.before)}</span> words</p>
        </div>
        <p class="rw-text" data-before={rewrite.before} data-after={rewrite.after}>
          <span class="rw-out">{rewrite.before}</span><span class="caret"></span>
        </p>
        <div class="rw-static">
          <p class="rw-before">{rewrite.before}</p>
          <p class="rw-after">{rewrite.after}</p>
        </div>
        <div class="rw-bar"><i></i></div>
      </div>
    </section>

    <section id="work" class="work wrap">
      <div class="sec-head grid">
        <p class="c-3"><span class="num">(03)</span> Selected work</p>
        <h2 class="c-9 sec-title" data-lines>Pages and campaigns, and what they did.</h2>
      </div>
      <div class="list" role="list">
        <div class="row row-head" aria-hidden="true">
          <span>No.</span><span>Project</span><span>For</span><span>Type</span><span class="right">Year</span>
        </div>
        {work.map((w, i) => {
          const Tag = w.href ? "a" : "div";
          return (
            <Tag class="row" role="listitem" data-reveal {...(w.href ? { href: w.href, target: "_blank", rel: "noopener" } : {})}>
              <span class="r-no">{pad(i + 1)}</span>
              <span class="r-title">{w.title}{w.href && <span class="arrow">↗</span>}</span>
              <span class="r-org">{w.org}</span>
              <span class="r-type">{w.type}</span>
              <span class="r-year right">{w.year}</span>
              <span class="r-card">
                <span class="card-result">{w.result}</span>
                <span class="card-note">{w.note}</span>
                <span class="card-meta">{w.type} · {w.year}</span>
              </span>
            </Tag>
          );
        })}
      </div>
      <div class="preview" aria-hidden="true"></div>
    </section>

    <section id="results" class="results wrap">
      <div class="sec-head grid">
        <p class="c-3"><span class="num">(04)</span> Results</p>
        <h2 class="c-9 sec-title" data-lines>Numbers, not adjectives.</h2>
      </div>
      <div class="stats">
        {results.map((r) => (
          <div class="stat" data-reveal>
            <p class="stat-value">
              {r.prefix}
              {r.count !== null && <span data-count={r.count}>{r.count}</span>}
              {r.suffix}
            </p>
            <p class="stat-label">{r.label}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="about" class="about wrap">
      <div class="sec-head grid">
        <p class="c-3"><span class="num">(05)</span> About</p>
      </div>
      <div class="grid about-grid">
        <figure class="photo c-4" data-reveal>
          <Picture
            src={photo}
            alt={`Portrait of ${person.name}`}
            formats={["avif", "webp"]}
            widths={[400, 700, 941]}
            sizes="(max-width: 860px) 420px, 33vw"
            loading="lazy"
          />
        </figure>
        <div class="about-text at-6">
          {about.paragraphs.map((p, i) => (
            <p class={i === 0 ? "about-lead" : "about-p"} data-lines>{p}</p>
          ))}

          <div class="about-cols">
            <div data-reveal>
              <h3 class="label">What I write</h3>
              <ul class="plain">
                {about.services.map((s) => <li>{s}</li>)}
              </ul>
            </div>
            <div data-reveal>
              <h3 class="label">Experience</h3>
              <ul class="plain exp">
                {about.experience.map((e) => (
                  <li><span>{e.role}<small>{e.org}</small></span><span class="mute">{e.years}</span></li>
                ))}
              </ul>
              <h3 class="label">Education</h3>
              <p>{about.education}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

    <footer id="contact" class="site-foot">
      <div class="sf-panel">
        <div class="sf-top">
          <div class="sf-brand">
            <a class="sf-logo" href="#top">jyoti chauhan</a>
            <div class="sf-legal">
              <p>© 2026 {person.name}</p>
              <p>{person.city} — <span data-clock>IST</span></p>
            </div>
          </div>
          <nav class="sf-col" aria-label="Site">
            <p class="sf-label">Site</p>
            <a href="#work">Selected work</a>
            <a href="#results">Results</a>
            <a href="#about">About</a>
            <a href="#top">Back to top</a>
          </nav>
          <nav class="sf-col" aria-label="Elsewhere">
            <p class="sf-label">Elsewhere</p>
            <a href={`mailto:${person.email}`}>Email</a>
            <a href="/ai/">Text version</a>
            <a href="/llms.txt">llms.txt</a>
            {person.resume && <a href={person.resume} download>Resume</a>}
          </nav>
          <div class="sf-hire">
            <p class="sf-label">Work with me</p>
            <p class="sf-pitch">Got a page that should rank? Let's write it together.</p>
            <a class="sf-field" href={`mailto:${person.email}`} data-cursor>
              <span>{person.email}</span><span class="sf-go" aria-hidden="true">&rarr;</span>
            </a>
            <p class="sf-note">
              Blogs, website copy, landing pages or campaigns: write to me with what you need.{" "}
              <button class="sf-copy" type="button" data-copy={person.email}>Copy address</button>
            </p>
          </div>
        </div>
        <div class="sf-sky">
          <canvas class="space" aria-hidden="true"></canvas>
          <div class="game" data-game hidden tabindex="0" role="application" aria-label="A small text platform game. Arrow keys to move, Space to jump, Escape to go back.">
            <pre class="game-screen" aria-hidden="true"></pre>
            <div class="game-pad" aria-hidden="true">
              <button type="button" data-key="left" tabindex="-1">&larr;</button>
              <button type="button" data-key="right" tabindex="-1">&rarr;</button>
              <button type="button" data-key="jump" tabindex="-1">Jump</button>
            </div>
          </div>
        </div>
      </div>
    </footer>

  <script>
    import "../scripts/main";
  </script>
</Base>
